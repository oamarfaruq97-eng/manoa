<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#182622" />
    <meta
      name="description"
      content="Discover considered private retreats in extraordinary places. Find your stillness with Manoa."
    />
    <title>Manoa — A stay beyond the ordinary</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="./app.js"></script>
  </head>
  <body class="bg-[#f2f1ec] text-[#1f2928] antialiased">
    <header class="absolute inset-x-0 top-0 z-20 text-white">
      <div class="mx-auto flex max-w-[1440px] items-center justify-between px-6 py-6 md:px-12 lg:px-16">
        <a href="#" class="group flex items-center gap-3" aria-label="Manoa home">
          <span class="grid h-10 w-10 place-items-center rounded-full border border-white/50 text-sm tracking-[0.18em] transition group-hover:bg-[#f2eee5] group-hover:text-[#1f2928]">M</span>
          <span class="text-sm font-medium uppercase tracking-[0.28em]">Manoa</span>
        </a>

        <nav id="site-nav" class="absolute left-0 right-0 top-full hidden flex-col gap-5 border-t border-white/15 bg-[#182622]/95 px-6 py-6 text-xs uppercase tracking-[0.2em] backdrop-blur-md md:static md:flex md:flex-row md:items-center md:gap-9 md:border-0 md:bg-transparent md:p-0">
          <a class="transition hover:text-white/65" href="#retreats">Our retreats</a>
          <a class="transition hover:text-white/65" href="#philosophy">The Manoa way</a>
          <a class="transition hover:text-white/65" href="#journal">Journal</a>
          <a class="md:hidden" href="#booking">Find your stay <span aria-hidden="true">↗</span></a>
        </nav>

        <a href="#booking" class="hidden border-b border-white/70 pb-1 text-xs uppercase tracking-[0.18em] transition hover:border-white md:inline-flex">
          Find your stay <span class="ml-3" aria-hidden="true">↗</span>
        </a>
        <button id="login-open" class="ml-auto mr-3 text-xs uppercase tracking-[0.15em] transition hover:text-white/65 md:ml-0 md:mr-0 md:border-b md:border-white/70 md:pb-1 md:tracking-[0.18em] md:hover:border-white" type="button">
          Log in
        </button>
        <button id="menu-button" class="grid h-10 w-10 place-items-center rounded-full border border-white/40 md:hidden" type="button" aria-label="Open menu" aria-controls="site-nav" aria-expanded="false">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M4 8h16M4 16h16" />
          </svg>
        </button>
      </div>
    </header>

    <main>
      <section class="relative flex min-h-[760px] h-[100svh] max-h-[1050px] items-end overflow-hidden bg-[#24352f] text-white">
        <img class="absolute inset-0 h-full w-full object-cover object-[54%_center]" src="./1.jpg" alt="A contemporary private villa nestled in a lush mountain landscape" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/55 via-black/15 to-black/5"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20"></div>

        <div class="relative mx-auto w-full max-w-[1440px] px-6 pb-12 pt-36 md:px-12 md:pb-16 lg:px-16">
          <p class="mb-6 flex items-center gap-3 text-[10px] uppercase tracking-[0.28em] text-white/80 md:text-xs">
            <span class="h-px w-8 bg-white/70"></span> Private stays, closer to nature
          </p>
          <h1 class="max-w-3xl font-serif text-5xl font-light leading-[1.04] tracking-[-0.035em] sm:text-6xl md:text-7xl lg:text-[92px]">
            A stay beyond<br />the ordinary.
          </h1>
          <div class="mt-7 flex flex-col gap-7 md:flex-row md:items-end md:justify-between">
            <p class="max-w-md text-sm leading-7 text-white/80 md:text-base">
              Considered places. Unhurried moments.<br class="hidden md:block" /> Find a little more room to feel.
            </p>
            <a href="#retreats" class="group inline-flex w-fit items-center gap-4 text-xs uppercase tracking-[0.18em]">
              Explore our places
              <span class="grid h-10 w-10 place-items-center rounded-full border border-white/60 transition group-hover:bg-[#f2eee5] group-hover:text-[#1f2928]" aria-hidden="true">↓</span>
            </a>
          </div>

          <form id="booking" class="mt-12 grid gap-px bg-white/30 p-px backdrop-blur-md sm:grid-cols-2 lg:mt-16 lg:grid-cols-[1.2fr_1.2fr_1fr_auto]">
            <label class="flex flex-col gap-2 bg-[#182622]/80 px-5 py-4">
              <span class="text-[9px] uppercase tracking-[0.2em] text-white/60">Arrive</span>
              <input id="arrival" class="w-full bg-transparent text-sm text-white outline-none [color-scheme:dark]" type="date" required aria-label="Arrival date" />
            </label>
            <label class="flex flex-col gap-2 bg-[#182622]/80 px-5 py-4">
              <span class="text-[9px] uppercase tracking-[0.2em] text-white/60">Depart</span>
              <input id="departure" class="w-full bg-transparent text-sm text-white outline-none [color-scheme:dark]" type="date" required aria-label="Departure date" />
            </label>
            <label class="flex flex-col gap-2 bg-[#182622]/80 px-5 py-4">
              <span class="text-[9px] uppercase tracking-[0.2em] text-white/60">Guests</span>
              <select id="guests" class="w-full appearance-none bg-transparent text-sm text-white outline-none [color-scheme:dark]" aria-label="Number of guests">
                <option class="text-[#1f2928]" value="2">2 guests</option>
                <option class="text-[#1f2928]" value="1">1 guest</option>
                <option class="text-[#1f2928]" value="3">3 guests</option>
                <option class="text-[#1f2928]" value="4">4 guests</option>
                <option class="text-[#1f2928]" value="5">5+ guests</option>
              </select>
            </label>
            <button class="flex min-h-14 items-center justify-center gap-3 bg-[#c4b397] px-8 text-xs font-medium uppercase tracking-[0.18em] text-[#1f2928] transition hover:bg-[#ded2bf] sm:col-span-2 lg:col-span-1" type="submit">
              Search stays <span aria-hidden="true">↗</span>
            </button>
          </form>
        </div>
        <span class="absolute bottom-7 right-6 hidden text-[9px] uppercase tracking-[0.22em] text-white/60 lg:block">01 / 06 &nbsp; — &nbsp; The collection</span>
      </section>

      <section id="philosophy" class="mx-auto grid max-w-[1440px] gap-10 px-6 py-24 md:grid-cols-[0.8fr_1.2fr] md:gap-20 md:px-12 md:py-32 lg:px-16">
        <div>
          <p class="mb-5 text-[10px] uppercase tracking-[0.24em] text-[#6b7771]">A different kind of escape</p>
          <h2 class="max-w-lg font-serif text-4xl font-light leading-tight tracking-[-0.025em] sm:text-5xl">
            The best places<br />bring you back to you.
          </h2>
        </div>
        <div class="flex flex-col justify-end md:pl-10">
          <p class="max-w-2xl text-base leading-8 text-[#5f6b67]">
            We find rare homes in remarkable landscapes, then leave room for the moments that matter. A quiet morning above the clouds. A long table, with nowhere else to be. This is travel at your own pace.
          </p>
          <a href="#retreats" class="mt-7 inline-flex w-fit items-center gap-4 border-b border-[#aeb7af] pb-2 text-xs uppercase tracking-[0.2em] transition hover:border-[#1f2928]">
            Get to know Manoa <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section id="retreats" class="bg-[#e5e8e2] px-6 py-20 md:px-12 md:py-28 lg:px-16">
        <div class="mx-auto max-w-[1440px]">
          <div class="mb-10 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between md:mb-14">
            <div>
              <p class="mb-4 text-[10px] uppercase tracking-[0.24em] text-[#6b7771]">Somewhere to begin</p>
              <h2 class="font-serif text-4xl font-light tracking-[-0.025em] sm:text-5xl">Places that stay with you.</h2>
            </div>
            <a class="inline-flex w-fit items-center gap-3 border-b border-[#aeb7af] pb-2 text-xs uppercase tracking-[0.18em] transition hover:border-[#1f2928]" href="#booking">
              View all retreats <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            <article class="group">
              <a class="relative block aspect-[4/5] overflow-hidden bg-[#c8d1cc]" href="#booking" aria-label="Discover the Cloud House retreat">
                <img class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]" src="./2.jpg" alt="An infinity pool looking out across misty mountain peaks" loading="lazy" />
                <span class="absolute left-5 top-5 border border-white/70 bg-black/10 px-3 py-2 text-[9px] uppercase tracking-[0.18em] text-white backdrop-blur-sm">Mountain hideaway</span>
                <span class="absolute bottom-5 right-5 grid h-10 w-10 place-items-center rounded-full bg-[#f2eee5] text-[#1f2928] transition group-hover:bg-[#182622] group-hover:text-white" aria-hidden="true">↗</span>
              </a>
              <div class="flex items-start justify-between gap-4 pt-5">
                <div>
                  <h3 class="font-serif text-2xl font-light">The Cloud House</h3>
                  <p class="mt-2 text-xs text-[#6b7771]">North Shore · 2–6 guests</p>
                </div>
                <span class="pt-1 text-[9px] uppercase tracking-[0.16em] text-[#6b7771]">01 / 03</span>
              </div>
            </article>

            <article class="group">
              <a class="relative block aspect-[4/5] overflow-hidden bg-[#c8d1cc]" href="#booking" aria-label="Discover the Stillwater retreat">
                <img class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]" src="./5.jpg" alt="Quiet modern bedroom opening onto a dramatic green coastline" loading="lazy" />
                <span class="absolute left-5 top-5 border border-white/70 bg-black/10 px-3 py-2 text-[9px] uppercase tracking-[0.18em] text-white backdrop-blur-sm">Ocean sanctuary</span>
                <span class="absolute bottom-5 right-5 grid h-10 w-10 place-items-center rounded-full bg-[#f2eee5] text-[#1f2928] transition group-hover:bg-[#182622] group-hover:text-white" aria-hidden="true">↗</span>
              </a>
              <div class="flex items-start justify-between gap-4 pt-5">
                <div>
                  <h3 class="font-serif text-2xl font-light">Stillwater</h3>
                  <p class="mt-2 text-xs text-[#6b7771]">The coast · 2–4 guests</p>
                </div>
                <span class="pt-1 text-[9px] uppercase tracking-[0.16em] text-[#6b7771]">02 / 03</span>
              </div>
            </article>

            <article class="group sm:col-span-2 lg:col-span-1">
              <a class="relative block aspect-[4/5] overflow-hidden bg-[#c8d1cc]" href="#booking" aria-label="Discover the Green Valley retreat">
                <img class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]" src="./6.jpg" alt="Minimalist white villa set against a forested hillside" loading="lazy" />
                <span class="absolute left-5 top-5 border border-white/70 bg-black/10 px-3 py-2 text-[9px] uppercase tracking-[0.18em] text-white backdrop-blur-sm">Forest retreat</span>
                <span class="absolute bottom-5 right-5 grid h-10 w-10 place-items-center rounded-full bg-[#f2eee5] text-[#1f2928] transition group-hover:bg-[#182622] group-hover:text-white" aria-hidden="true">↗</span>
              </a>
              <div class="flex items-start justify-between gap-4 pt-5">
                <div>
                  <h3 class="font-serif text-2xl font-light">Green Valley</h3>
                  <p class="mt-2 text-xs text-[#6b7771]">In the wild · 2–8 guests</p>
                </div>
                <span class="pt-1 text-[9px] uppercase tracking-[0.16em] text-[#6b7771]">03 / 03</span>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="relative min-h-[580px] overflow-hidden bg-[#263936] text-white">
        <img class="absolute inset-0 h-full w-full object-cover object-center" src="./3.jpg" alt="A peaceful, light-filled home office framed by coastal views" loading="lazy" />
        <div class="absolute inset-0 bg-[#172624]/60"></div>
        <div class="relative mx-auto flex min-h-[580px] max-w-[1440px] items-center px-6 py-20 md:px-12 lg:px-16">
          <div class="max-w-2xl">
            <p class="mb-6 text-[10px] uppercase tracking-[0.25em] text-white/75">A little more of what matters</p>
            <h2 class="font-serif text-5xl font-light leading-[1.08] tracking-[-0.03em] sm:text-6xl md:text-7xl">Leave a little<br />space for wonder.</h2>
            <p class="mt-7 max-w-md text-sm leading-7 text-white/75">Thoughtful homes, a lighter footprint, and the freedom to find your own rhythm.</p>
            <a class="mt-9 inline-flex items-center gap-4 border-b border-white/60 pb-2 text-xs uppercase tracking-[0.2em] transition hover:border-white" href="#journal">
              Our way of staying <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <section id="journal" class="mx-auto grid max-w-[1440px] gap-10 px-6 py-24 md:grid-cols-2 md:items-center md:gap-20 md:px-12 md:py-32 lg:px-16">
        <div class="order-2 md:order-1">
          <p class="mb-5 text-[10px] uppercase tracking-[0.24em] text-[#6b7771]">A note from Manoa</p>
          <h2 class="max-w-lg font-serif text-4xl font-light leading-tight tracking-[-0.025em] sm:text-5xl">A little inspiration for going nowhere fast.</h2>
          <p class="mt-6 max-w-lg text-sm leading-7 text-[#5f6b67]">Occasional letters from the places we love: new stays, thoughtful travel, and small ways to slow down.</p>
          <form id="newsletter" class="mt-8 flex max-w-lg border-b border-[#aeb7af]">
            <label class="sr-only" for="email">Your email address</label>
            <input id="email" class="min-w-0 flex-1 bg-transparent py-4 text-sm outline-none placeholder:text-[#78827d]" type="email" placeholder="Your email address" required autocomplete="email" />
            <button class="shrink-0 py-4 pl-4 text-xs uppercase tracking-[0.18em] transition hover:text-[#6b7771]" type="submit">Join us <span class="ml-2" aria-hidden="true">↗</span></button>
          </form>
          <p id="newsletter-message" class="mt-3 min-h-5 text-xs text-[#5f6b67]" aria-live="polite"></p>
        </div>
        <div class="order-1 aspect-[4/3] overflow-hidden bg-[#c8d1cc] md:order-2">
          <img class="h-full w-full object-cover" src="./4.jpg" alt="The view from a serene bedroom looking across an island landscape" loading="lazy" />
        </div>
      </section>
    </main>

    <footer class="bg-[#182622] text-white">
      <div class="mx-auto max-w-[1440px] px-6 py-12 md:px-12 md:py-16 lg:px-16">
        <div class="flex flex-col gap-10 border-b border-white/15 pb-10 md:flex-row md:items-end md:justify-between">
          <div>
            <a href="#" class="text-sm uppercase tracking-[0.28em]">Manoa</a>
            <p class="mt-4 max-w-xs text-xs leading-6 text-white/55">A collection of considered stays in the places that make you feel something.</p>
          </div>
          <div class="flex flex-wrap gap-x-8 gap-y-4 text-xs uppercase tracking-[0.18em] text-white/70">
            <a class="hover:text-white" href="#retreats">Retreats</a>
            <a class="hover:text-white" href="#philosophy">Our story</a>
            <a class="hover:text-white" href="#journal">Journal</a>
            <a class="hover:text-white" href="mailto:hello@manoa.stays">Get in touch</a>
          </div>
        </div>
        <div class="flex flex-col gap-3 pt-6 text-[9px] uppercase tracking-[0.14em] text-white/45 sm:flex-row sm:justify-between">
          <span>© <span id="year"></span> Manoa Stays</span>
          <span>Made for the moments in between.</span>
        </div>
      </div>
    </footer>

    <dialog id="login-dialog" class="m-auto w-[calc(100%-2rem)] max-w-md border-0 bg-[#f2f1ec] p-0 text-[#1f2928] shadow-2xl backdrop:bg-[#101711]/75">
      <div class="p-7 sm:p-10">
        <div class="flex items-start justify-between gap-5">
          <div>
            <p id="auth-eyebrow" class="mb-3 text-[10px] uppercase tracking-[0.22em] text-[#6b7771]">Welcome back</p>
            <h2 id="auth-title" class="font-serif text-3xl font-light">Log in to Manoa</h2>
          </div>
          <button id="login-close" class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-[#c4ccc5] text-xl leading-none transition hover:bg-[#e5e8e2]" type="button" aria-label="Close login dialog">×</button>
        </div>
        <form id="login-form" class="mt-8 space-y-5" data-auth-form="login">
          <label class="block">
            <span class="mb-2 block text-[9px] uppercase tracking-[0.18em] text-[#6b7771]">Email address</span>
            <input id="login-email" class="w-full border-b border-[#aeb7af] bg-transparent py-3 text-sm outline-none transition focus:border-[#1f2928]" type="email" placeholder="you@example.com" autocomplete="email" required />
          </label>
          <label class="block">
            <span class="mb-2 block text-[9px] uppercase tracking-[0.18em] text-[#6b7771]">Password</span>
            <span class="flex items-center border-b border-[#aeb7af] focus-within:border-[#1f2928]">
              <input id="login-password" class="w-full bg-transparent py-3 text-sm outline-none" type="password" placeholder="Enter your password" autocomplete="current-password" required />
              <button class="shrink-0 py-2 pl-3 text-[#5f6b67] transition hover:text-[#1f2928]" type="button" data-password-toggle="login-password" aria-label="Show password">
                <svg class="h-5 w-5" data-eye-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                <svg class="hidden h-5 w-5" data-eye-off-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 3 18 18M10.6 6.2A10.7 10.7 0 0 1 12 6c6 0 9.5 6 9.5 6a15 15 0 0 1-3.1 3.6M6.2 6.2C3.9 7.7 2.5 12 2.5 12s3.5 6 9.5 6c1 0 1.9-.2 2.8-.5"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
              </button>
            </span>
          </label>
          <button class="flex w-full items-center justify-center gap-3 bg-[#182622] px-5 py-4 text-xs uppercase tracking-[0.18em] text-white transition hover:bg-[#2b4039]" type="submit">
            Log in <span aria-hidden="true">↗</span>
          </button>
          <div class="grid grid-cols-2 items-center gap-4 text-xs">
            <button class="auth-switch justify-self-start text-left underline underline-offset-4" type="button" data-auth-mode="forgot">Forgot password?</button>
            <button class="auth-switch justify-self-end text-right underline underline-offset-4" type="button" data-auth-mode="signup">Create account</button>
          </div>
        </form>
        <form id="signup-form" class="mt-8 hidden space-y-5" data-auth-form="signup">
          <label class="block">
            <span class="mb-2 block text-[9px] uppercase tracking-[0.18em] text-[#6b7771]">Full name</span>
            <input class="w-full border-b border-[#aeb7af] bg-transparent py-3 text-sm outline-none transition focus:border-[#1f2928]" type="text" placeholder="Your name" autocomplete="name" required />
          </label>
          <label class="block">
            <span class="mb-2 block text-[9px] uppercase tracking-[0.18em] text-[#6b7771]">Email address</span>
            <input class="w-full border-b border-[#aeb7af] bg-transparent py-3 text-sm outline-none transition focus:border-[#1f2928]" type="email" placeholder="you@example.com" autocomplete="email" required />
          </label>
          <label class="block">
            <span class="mb-2 block text-[9px] uppercase tracking-[0.18em] text-[#6b7771]">Create password</span>
            <span class="flex items-center border-b border-[#aeb7af] focus-within:border-[#1f2928]">
              <input id="signup-password" class="w-full bg-transparent py-3 text-sm outline-none" type="password" placeholder="Create a password" autocomplete="new-password" required />
              <button class="shrink-0 py-2 pl-3 text-[#5f6b67] transition hover:text-[#1f2928]" type="button" data-password-toggle="signup-password" aria-label="Show password">
                <svg class="h-5 w-5" data-eye-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                <svg class="hidden h-5 w-5" data-eye-off-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 3 18 18M10.6 6.2A10.7 10.7 0 0 1 12 6c6 0 9.5 6 9.5 6a15 15 0 0 1-3.1 3.6M6.2 6.2C3.9 7.7 2.5 12 2.5 12s3.5 6 9.5 6c1 0 1.9-.2 2.8-.5"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
              </button>
            </span>
          </label>
          <label class="block">
            <span class="mb-2 block text-[9px] uppercase tracking-[0.18em] text-[#6b7771]">Confirm password</span>
            <span class="flex items-center border-b border-[#aeb7af] focus-within:border-[#1f2928]">
              <input id="signup-confirm-password" class="w-full bg-transparent py-3 text-sm outline-none" type="password" placeholder="Enter your password again" autocomplete="new-password" required />
              <button class="shrink-0 py-2 pl-3 text-[#5f6b67] transition hover:text-[#1f2928]" type="button" data-password-toggle="signup-confirm-password" aria-label="Show password">
                <svg class="h-5 w-5" data-eye-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                <svg class="hidden h-5 w-5" data-eye-off-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 3 18 18M10.6 6.2A10.7 10.7 0 0 1 12 6c6 0 9.5 6 9.5 6a15 15 0 0 1-3.1 3.6M6.2 6.2C3.9 7.7 2.5 12 2.5 12s3.5 6 9.5 6c1 0 1.9-.2 2.8-.5"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
              </button>
            </span>
          </label>
          <button class="flex w-full items-center justify-center gap-3 bg-[#182622] px-5 py-4 text-xs uppercase tracking-[0.18em] text-white transition hover:bg-[#2b4039]" type="submit">
            Create account <span aria-hidden="true">↗</span>
          </button>
          <button class="auth-switch w-full text-center text-xs underline underline-offset-4" type="button" data-auth-mode="login">Back to log in</button>
        </form>
        <form id="forgot-form" class="mt-8 hidden space-y-5" data-auth-form="forgot">
          <p class="text-sm leading-6 text-[#5f6b67]">Enter the email address associated with your account.</p>
          <label class="block">
            <span class="mb-2 block text-[9px] uppercase tracking-[0.18em] text-[#6b7771]">Email address</span>
            <input class="w-full border-b border-[#aeb7af] bg-transparent py-3 text-sm outline-none transition focus:border-[#1f2928]" type="email" placeholder="you@example.com" autocomplete="email" required />
          </label>
          <button class="flex w-full items-center justify-center gap-3 bg-[#182622] px-5 py-4 text-xs uppercase tracking-[0.18em] text-white transition hover:bg-[#2b4039]" type="submit">
            Reset password <span aria-hidden="true">↗</span>
          </button>
          <button class="auth-switch w-full text-center text-xs underline underline-offset-4" type="button" data-auth-mode="login">Back to log in</button>
        </form>
        <p id="login-message" class="mt-3 min-h-5 text-center text-xs leading-5 text-[#5f6b67]" aria-live="polite"></p>
      </div>
    </dialog>

    <div id="toast" class="pointer-events-none fixed bottom-5 left-1/2 z-50 hidden w-[calc(100%-2.5rem)] max-w-md -translate-x-1/2 border border-white/15 bg-[#182622] px-5 py-4 text-center text-sm text-white shadow-xl" role="status" aria-live="polite"></div>
  </body>
</html>
